# ---------------------------------------------------------------------------
# VentaPlay WA Bridge — API
# Copia este archivo a .env y ajusta. Nunca subas el .env al repo.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# orígenes de la web permitidos (coma)
WEB_ORIGIN=http://localhost:5173

# baileys = WhatsApp real · simulator = QR y datos falsos para desarrollar la UI
WA_DRIVER=simulator
# proxy opcional para el WebSocket de WhatsApp
WA_PROXY_URL=

# file = carpeta local cifrada (DATA_DIR) · postgres = DATABASE_URL (Supabase)
STORAGE=file
DATA_DIR=./data
DATABASE_URL=

# 32 bytes en hex. Genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la pierdes, las sesiones guardadas no se pueden descifrar (hay que volver a escanear).
ENCRYPTION_KEY=

# --- Autenticación (al menos una en producción) ---
# Token compartido del equipo (mín. 16 caracteres)
API_TOKEN=cambia-este-token-local
# Supabase Auth: valida el JWT del usuario y exige correo @ventaplay.com
SUPABASE_URL=
# solo si el proyecto usa la clave JWT legacy (HS256); con claves asimétricas se usa JWKS
SUPABASE_JWT_SECRET=
ALLOWED_EMAIL_DOMAINS=ventaplay.com

MAX_SESSIONS=20
# borra credenciales locales si el teléfono desvincula el dispositivo
WIPE_ON_LOGOUT=true
